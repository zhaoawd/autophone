# Python & virtual environments
__pycache__/
*.pyc
.venv/
.venv-*/
.ci-venv/
.ci-venv-310/

# Build & release outputs
dist/
/dist-ci/

# OS & editor files
.DS_Store
.idea/
~$*

# Runtime locks, logs, caches & local state
*.autophone.lock
.worktrees/
.verify_shots/
/logs/
/.cache/
/.claude/scheduled_tasks.lock
.autophone-transient/
/runs/
/rig-observed-state/
/family-candidates/
/case-import-batches/
