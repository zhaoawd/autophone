/support/lock-state/lock_state
/support/lock-state/lock_state.build.json
/support/lock-state/.lock_state.*
/tools/guest/

# Local IPA artifacts & per-target installation receipts
/packages/**/*.ipa
/packages/*/installations/
/packages/*/install-receipt.json
/packages/*/manifest.v1.bak.json
/artifacts/reverse/

# Frida agent build outputs & local capture runs
