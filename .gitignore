/tools/phase4/
/tools/phase5/runs/
/autophone/observation/frida/agent/node_modules/
/autophone/observation/frida/agent/_build/
/autophone/observation/frida/runs/
/autophone/_data/generated/

# Node & Playwright E2E outputs
**/node_modules
/test-results/
/playwright-report/

# Local overlays & developer credentials (never commit)
config/*.local.yaml
config/location-points.local.yaml
config/location-checkpoints.local.json
config/location-policies.local.yaml
config/location-audit.local.jsonl
config/autophone.local.env

