{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autophone/schemas/knowledge-coverage-result.v1.json",
  "title": "Evaluated knowledge coverage result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "raw_coverage", "business_coverage", "counts", "cells", "build_queue"],
  "properties": {
    "schema_version": {"const": "v1"},
    "raw_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "business_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "cells": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluated_cell"}
    },
    "build_queue": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluated_cell"}
    }
  },
  "$defs": {
    "evaluated_cell": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "current_state", "build_priority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "business_weight": {"type": "number", "minimum": 0},
        "evidence_cost": {"type": "number", "minimum": 0},
        "effect_risk": {"type": "number", "minimum": 0},
        "current_state": {"enum": ["covered", "partial", "unknown", "blocked", "out_of_scope"]},
        "build_priority": {"type": "number", "minimum": 0}
      }
    }
  }
}
