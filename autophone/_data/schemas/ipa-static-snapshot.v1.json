{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autophone/schemas/ipa-static-snapshot.v1.json",
  "title": "Canonical IPA static snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_sha256", "extractor_rules_sha256", "snapshot_digest", "detectors"],
  "properties": {
    "schema_version": {"const": "v1"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extractor_rules_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "detectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "status", "observations", "digest"],
        "properties": {
          "scope": {"type": "string"},
          "status": {"enum": ["complete", "partial", "unavailable"]},
          "observations": {},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
