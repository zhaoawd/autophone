{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autophone/schemas/release-manifest.v1.json",
  "title": "ReleaseManifest",
  "description": "Autophone 发布版本身份及安装前兼容性约束。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "commit", "built_at", "state_schema", "compat"],
  "properties": {
    "schema_version": { "const": "release-manifest.v1" },
    "version": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "commit": { "$ref": "#/$defs/commit" },
    "built_at": { "type": "string", "format": "date-time" },
    "state_schema": { "type": "integer", "minimum": 0 },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "frida"],
      "anyOf": [
        { "required": ["uds_commands"] },
        { "required": ["uds"] }
      ],
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^(?:>=|<=|==|>|<)[0-9]+(?:\\.[0-9]+){1,2}(?:,(?:>=|<=|==|>|<)[0-9]+(?:\\.[0-9]+){1,2})*$",
          "description": "逗号分隔的 Python 数字版本比较式，例如 >=3.10,<3.14。"
        },
        "frida": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "uds_commands": {
          "$ref": "#/$defs/commands",
          "description": "兼容旧 manifest 的必需 UDS 命令列表。"
        },
        "optional_uds_commands": {
          "$ref": "#/$defs/commands",
          "description": "兼容旧 manifest 的可选 UDS 命令列表。"
        },
        "uds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "$ref": "#/$defs/commands" },
            "optional": { "$ref": "#/$defs/commands" }
          }
        },
        "vphone_cli_min_commit": {
          "$ref": "#/$defs/commit",
          "description": "历史字段名。兼容检查仅比较是否相等并输出诊断，不推断 commit 顺序。"
        },
        "vphone_cli_commit": {
          "$ref": "#/$defs/commit",
          "description": "发布时验证过的 vphone-cli commit，仅用于诊断。"
        }
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "commands": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    }
  }
}
