{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autophone/schemas/ai-fix-proposal.v1.json",
  "title": "AI fix proposal",
  "description": "Human-in-the-loop repair proposal derived from ai-diagnosis.json. It may create draft assets only after explicit apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "run_id", "kind", "status", "target", "patch", "provenance", "created_at"],
  "properties": {
    "schema_version": { "const": "v1" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_dir": { "type": ["string", "null"] },
    "app": { "type": ["string", "null"] },
    "kind": { "enum": ["recipe_patch", "case_edit", "operation_draft", "no_fix"] },
    "status": { "enum": ["proposed", "applied", "rejected", "no_fix", "error"] },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "case_id": { "type": ["string", "null"] },
        "asset": { "type": ["string", "null"] },
        "operation": { "type": ["string", "null"] }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": true,
      "description": "Draft payload. recipe_patch may include steps; case_edit may include changes; operation_draft may include fields or requirement."
    },
    "route": { "type": "object", "additionalProperties": true },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] }
      }
    },
    "applied": { "type": "object", "additionalProperties": true },
    "rejection": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
