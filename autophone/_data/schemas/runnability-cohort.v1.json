{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autophone/schemas/runnability-cohort.v1.json",
  "title": "RunnabilityCohort",
  "description": "可运行率基线的冻结 cohort：Case 列表、选择器、资产哈希、目标 Rig 与计划 run_id。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "frozen_at",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": "runnability-cohort/v1"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1
    },
    "frozen_at": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app",
          "target_rig",
          "rounds",
          "selector",
          "exclude_ids",
          "golden_path",
          "case_ids",
          "submit_selector",
          "recipes",
          "asset_sha256",
          "runs"
        ],
        "properties": {
          "app": {
            "type": "string",
            "minLength": 1
          },
          "target_rig": {
            "type": "string",
            "minLength": 1
          },
          "rounds": {
            "type": "integer",
            "minimum": 1
          },
          "selector": {
            "type": "object"
          },
          "exclude_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "golden_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "submit_selector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ids"
            ],
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "recipes": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "asset_sha256": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "round",
                "run_id"
              ],
              "properties": {
                "round": {
                  "type": "integer",
                  "minimum": 1
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
