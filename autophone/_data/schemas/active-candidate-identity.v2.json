{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autophone/schemas/active-candidate-identity.v2.json",
  "title": "ActiveCandidateIdentity",
  "description": "Active Candidate Identity v2。projection_version 显式记录 Native Runtime ID 的投影规则版本。Readback 固定为 identity_only，不声明 source_root_id / lineage_id，不构成 Property Evidence；宿主校验、typed Subject Epoch 与 Expo 产品端口已接通。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_version",
    "target_fingerprint",
    "bundle_id",
    "base_build_id",
    "base_ipa_sha256",
    "native_runtime_id",
    "update_source",
    "active_update_id",
    "main_jsbundle_sha256",
    "assets_tree_sha256",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "active-candidate-identity/v2"
    },
    "target_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"
    },
    "base_build_id": {
      "type": "string",
      "pattern": "^bld-[0-9a-f]{12,64}$"
    },
    "base_ipa_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_runtime_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "update_source": {
      "enum": [
        "embedded",
        "ota"
      ]
    },
    "active_update_id": {
      "type": "string",
      "pattern": "^upd-[0-9A-Za-z._-]{1,120}$"
    },
    "main_jsbundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assets_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "projection_version": {
      "type": "string",
      "pattern": "^rn-native-projection/[1-9][0-9]*$",
      "description": "结构校验接受正整数版本；消费方须先核对与 Native Runtime Record 的版本一致并受支持，再比较 ID。"
    }
  }
}
