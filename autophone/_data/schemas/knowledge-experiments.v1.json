{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autophone/schemas/knowledge-experiments.v1.json",
  "title": "Declared controlled experiments for an app (M3b source of truth)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app", "experiments"],
  "properties": {
    "schema_version": {"const": "v1"},
    "app": {"type": "string", "minLength": 1},
    "experiments": {
      "type": "array",
      "items": {"$ref": "#/$defs/experiment"}
    }
  },
  "$defs": {
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "claim_id", "contrast_group", "manipulated_input", "arms"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "contrast_group": {"type": "string", "minLength": 1},
        "manipulated_input": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "arms": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/arm"}
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_input", "expect", "bindings"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target_input": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "verdict"],
          "properties": {
            "case_id": {"type": "string", "minLength": 1},
            "verdict": {"const": "passed"}
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["match"],
            "properties": {
              "match": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "required": ["case_id"],
                "properties": {
                  "observation_id": {"type": "string"},
                  "type": {"type": "string"},
                  "case_id": {"type": "string"},
                  "operation": {"type": "string"},
                  "action_id": {"type": "string"}
                }
              },
              "independent_readback": {"const": true}
            }
          }
        }
      }
    }
  }
}
