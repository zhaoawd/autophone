{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autophone/schemas/negative-controls.v1.json",
  "title": "NegativeControls",
  "description": "App 级区分力负对照声明（apps/<app>/discrimination/negative_controls.yaml）。每条声明为一个 Case 指定最小反向状态的确定性注入方式（跳过 Recipe 中的指定步骤，或以声明的替代参数执行指定步骤），以及反向 Run 必须失败的断言步骤。反向状态只由本声明决定，不由运行期决策生成。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "controls"],
  "properties": {
    "schema": { "const": "autophone.negative-controls/1" },
    "controls": {
      "type": "array",
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "stepLocator": {
      "type": "object",
      "additionalProperties": false,
      "description": "按 Recipe 步骤名定位一步。operation 与 action 二选一；同名步骤出现多次时必须用 occurrence（从 1 起）点名，否则定位失败。",
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "occurrence": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [
        { "required": ["operation"], "not": { "required": ["action"] } },
        { "required": ["action"], "not": { "required": ["operation"] } }
      ]
    },
    "skipStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "step"],
      "properties": {
        "kind": { "const": "skip_step" },
        "step": { "$ref": "#/$defs/stepLocator" }
      }
    },
    "replaceArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "step", "args"],
      "description": "以声明的替代参数执行指定步骤：operation 步骤合并进 args，action 步骤替换同名顶层参数。替代后参数必须与原步骤不同。",
      "properties": {
        "kind": { "const": "replace_args" },
        "step": { "$ref": "#/$defs/stepLocator" },
        "args": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "not": { "enum": ["action", "operation", "args"] } }
        }
      }
    },
    "flipWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "step"
      ],
      "description": "从同一步 Operation 的 witness.negative_control 读取翻转参数和预测 stage。",
      "properties": {
        "kind": {
          "const": "flip_witness"
        },
        "step": {
          "allOf": [
            {
              "$ref": "#/$defs/stepLocator"
            },
            {
              "required": [
                "operation"
              ]
            }
          ]
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "hypothesis", "perturbation", "expect"],
      "allOf": [{
        "if": { "properties": { "perturbation": { "properties": { "kind": { "const": "flip_witness" } } } } },
        "then": {
          "properties": {
            "expect": {
              "required": ["step"],
              "not": { "required": ["fail_kinds"] },
              "properties": { "plane": { "const": "ui" } }
            }
          }
        }
      }],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "case_id": { "type": "string", "minLength": 1 },
        "hypothesis": { "type": "string", "minLength": 1 },
        "perturbation": {
          "oneOf": [
            { "$ref": "#/$defs/skipStep" },
            { "$ref": "#/$defs/replaceArgs" },
            { "$ref": "#/$defs/flipWitness" }
          ]
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "description": "反向 Run 必须以 failed 状态停在声明的断言步骤或联合裁决面。plane 缺省或为 ui 时必须声明 step（Recipe 层步骤名须以 assert 开头，且位于扰动步骤之后；flip_witness 必须定位被扰动的同一步 Operation）；plane 为 api / readback / joint 时 step 可省略，以交互窗口 API / 后置回读 / 联合裁决失败归类判定区分力。失败归类必须属于 fail_kinds；设施类失败归类（如 ax_unavailable）不计入。",
          "if": {
            "required": ["plane"],
            "properties": {
              "plane": { "enum": ["api", "readback", "joint"] }
            }
          },
          "then": {},
          "else": {
            "required": ["step"]
          },
          "properties": {
            "plane": { "enum": ["ui", "api", "readback", "joint"] },
            "step": { "$ref": "#/$defs/stepLocator" },
            "fail_kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
