{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-ref.v1.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_kind",
        "build_ref"
      ],
      "properties": {
        "candidate_kind": {
          "const": "ipa"
        },
        "build_ref": {
          "type": "object",
          "required": [
            "app",
            "slot",
            "build_id",
            "artifact_sha256"
          ],
          "properties": {
            "app": {
              "type": "string",
              "minLength": 1
            },
            "slot": {
              "type": "string",
              "minLength": 1
            },
            "build_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "native_runtime_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_kind",
        "native_shell",
        "rn_update"
      ],
      "properties": {
        "candidate_kind": {
          "const": "rn_update"
        },
        "native_shell": {
          "type": "object",
          "required": [
            "app",
            "slot",
            "build_id",
            "artifact_sha256",
            "native_runtime_id"
          ],
          "properties": {
            "app": {
              "type": "string",
              "minLength": 1
            },
            "slot": {
              "type": "string",
              "minLength": 1
            },
            "build_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "native_runtime_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        },
        "rn_update": {
          "type": "object",
          "required": [
            "update_id",
            "source_tree_sha256",
            "manifest_sha256",
            "artifact_ref",
            "source_revision"
          ],
          "properties": {
            "update_id": {
              "type": "string",
              "minLength": 1
            },
            "source_tree_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_ref": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "object"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
